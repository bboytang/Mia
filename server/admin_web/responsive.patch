diff --git a/main/manager-web/src/utils/responsive.js b/main/manager-web/src/utils/responsive.js
new file mode 100644
index 0000000..462429b
--- /dev/null
+++ b/main/manager-web/src/utils/responsive.js
@@ -0,0 +1,27 @@
+// Shared breakpoints for navigation, lists and CSS. Width, rather than user agent,
+// also handles tablet rotation and desktop windows resized to a compact viewport.
+export function installResponsive(Vue) {
+  const compact = window.matchMedia('(max-width: 1180px)');
+  const mobile = window.matchMedia('(max-width: 600px)');
+  const state = Vue.observable({ compact: compact.matches, mobile: mobile.matches });
+  Vue.prototype.$responsive = state;
+  const update = () => {
+    state.compact = compact.matches;
+    state.mobile = mobile.matches;
+  };
+  [compact, mobile].forEach(query => {
+    if (query.addEventListener) query.addEventListener('change', update);
+    else query.addListener(update);
+  });
+  const viewport = window.visualViewport;
+  const updateViewport = () => {
+    document.documentElement.style.setProperty('--visible-height', `${viewport ? viewport.height : window.innerHeight}px`);
+    document.documentElement.style.setProperty('--visible-top', `${viewport ? viewport.offsetTop : 0}px`);
+  };
+  window.addEventListener('resize', updateViewport);
+  if (viewport) {
+    viewport.addEventListener('resize', updateViewport);
+    viewport.addEventListener('scroll', updateViewport);
+  }
+  updateViewport();
+}
