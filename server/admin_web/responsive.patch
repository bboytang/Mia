diff --git a/main/manager-web/src/styles/responsive.scss b/main/manager-web/src/styles/responsive.scss
new file mode 100644
index 0000000..16dfcfe
--- /dev/null
+++ b/main/manager-web/src/styles/responsive.scss
@@ -0,0 +1,350 @@
+// One layout system layered over the existing desktop design. Page-level selectors
+// deliberately outrank scoped desktop styles without hiding horizontal overflow.
+:root {
+  --visible-height: 100vh;
+  --visible-top: 0px;
+}
+.navigation-toggle, .navigation-backdrop { display: none; }
+button.settings-btn { border: 0; font-family: inherit; }
+.mobile-records { min-width: 0; text-align: left; }
+.mobile-records-empty { padding: 32px 12px; color: #909399; }
+.mobile-record {
+  margin-bottom: 12px; padding: 12px; border: 1px solid #dfe7f5;
+  border-radius: 12px; background: #fafcfe;
+  dl { margin: 12px 0; }
+  .mobile-record-field { padding: 7px 0; }
+  dt { color: #69738b; font-size: 12px; margin-bottom: 5px; }
+  dd { margin: 0; min-width: 0; overflow-wrap: anywhere; white-space: normal; }
+}
+.mobile-record-selection, .mobile-record-actions {
+  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
+}
+
+@media (max-width: 1180px) {
+  #app .responsive-page {
+    box-sizing: border-box; min-width: 0; width: 100%; min-height: 100vh;
+    min-height: 100dvh; height: auto; overflow: visible;
+    padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right);
+    padding-bottom: env(safe-area-inset-bottom);
+  }
+  #app .header {
+    min-width: 0; flex-shrink: 0; padding: 0 12px;
+    height: calc(63px + env(safe-area-inset-top)) !important;
+    padding-top: env(safe-area-inset-top);
+    box-sizing: border-box;
+    .header-container { padding: 0; gap: 10px; }
+    .header-left { min-width: 0; margin-right: auto; }
+    .header-right { min-width: 0; max-width: 36%; }
+    .el-user-dropdown { overflow-wrap: anywhere; }
+    .navigation-toggle {
+      display: inline-flex; align-items: center; justify-content: center;
+      width: 44px; height: 44px; flex-shrink: 0; border: 1px solid #d4dff1;
+      border-radius: 10px; background: white; color: #5778ff; font-size: 22px;
+      position: relative; z-index: 1903;
+    }
+    .navigation-backdrop {
+      display: block; position: fixed; inset: 0; border: 0; padding: 0;
+      background: rgba(24, 39, 65, .35); z-index: 1900;
+    }
+    .header-center {
+      box-sizing: border-box; position: fixed; z-index: 1902;
+      top: calc(var(--visible-top) + 63px + env(safe-area-inset-top));
+      left: max(12px, env(safe-area-inset-left)); right: max(12px, env(safe-area-inset-right));
+      max-height: calc(var(--visible-height) - 83px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
+      padding: 12px; border-radius: 12px; overflow-y: auto;
+      display: flex; flex-direction: column; align-items: stretch; gap: 8px;
+      .equipment-management { min-height: 44px; min-width: 0; font-size: 16px; justify-content: flex-start; box-sizing: border-box; }
+      .el-dropdown-link { width: 100%; }
+      .nav-text { text-align: left; }
+    }
+  }
+  #app .responsive-page {
+    .main-wrapper { min-width: 0; height: auto; margin: 12px; flex: 1; }
+    .content-panel, .content-area { min-width: 0; height: auto; overflow: visible; }
+    .content-area { width: 0; }
+    .el-card { min-width: 0; height: auto; overflow: visible; }
+    .el-card__body { box-sizing: border-box; min-width: 0; height: auto; padding: 16px; overflow: visible !important; }
+    .operation-header, .operation-bar, .config-header { flex-wrap: wrap; height: auto; gap: 12px; }
+    .right-operations, .header-actions, .action-group, .search-group, .ctrl_btn, .batch-actions { flex-wrap: wrap; gap: 8px; min-width: 0; }
+    .header-actions { margin-left: 0; }
+    .operation-bar { padding: 12px; }
+    .custom-table-wrapper { min-width: 0; }
+    .table-container { height: 500px !important; min-width: 0; }
+    .el-table { min-width: 0; }
+    .table-footer { flex-wrap: wrap; gap: 12px; height: auto; }
+    .pagination-wrapper { max-width: 100%; }
+    .page-title, .header-title { overflow-wrap: anywhere; }
+    .el-footer { height: auto !important; min-height: 35px; padding: 12px; }
+    .copyright { height: auto; }
+    .features-grid, .doc-grid, .permission-grid, .voice-clone-grid, .device-list-container {
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
+      height: auto; min-width: 0; overflow: visible;
+    }
+    .device-item, .feature-card-item, .voice-clone-card { width: 100% !important; min-width: 0; height: auto; }
+    .device-actions, .version-info { flex-wrap: wrap; }
+    .device-item-title, .device-name, .info-value, .server-value { white-space: normal; overflow-wrap: anywhere; }
+    .server-list, .server-list-card, .feature-groups-container, .params-body, .doc-section { height: auto; overflow: visible; }
+    .server-card, .server-info { min-width: 0; }
+    .full-height-form, .full-height-form .el-form-item, .nickname-item, .description-item { height: auto !important; }
+    .full-height-form .el-textarea__inner { height: auto !important; min-height: 160px; }
+    .params-table .cell { white-space: normal; overflow-wrap: anywhere; }
+    .section-title { flex-wrap: wrap; line-height: 1.5; padding: 10px 0; }
+    .el-collapse-item__header { height: auto; min-height: 48px; }
+    .group-tabs, .sub-tabs { flex-wrap: wrap; }
+  }
+  // Bound all appended overlays too: Element UI may mount them outside #app.
+  .el-dialog__wrapper {
+    padding: 12px max(12px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
+    box-sizing: border-box;
+    .el-dialog {
+      box-sizing: border-box; min-width: 0 !important;
+      width: min(94vw, 900px) !important; max-width: 100%; height: auto !important;
+      margin: 0 auto !important; top: var(--visible-top) !important; left: auto !important; right: auto !important;
+      transform: none !important;
+      max-height: calc(var(--visible-height) - 24px - env(safe-area-inset-bottom));
+      display: flex; flex-direction: column; overflow: hidden;
+    }
+    .el-dialog__header { flex-shrink: 0; padding: 16px 60px 16px 16px; }
+    .el-dialog__headerbtn { top: 8px !important; right: 8px !important; width: 44px !important; height: 44px !important; }
+    .el-dialog__body { padding: 16px; min-height: 0; overflow: auto; overflow-wrap: anywhere; }
+    .el-dialog__footer { flex-shrink: 0; padding: 12px 16px; }
+    .dialog-scroll-body, .dialog-content, .chat-container { height: auto !important; min-width: 0; }
